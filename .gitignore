# Everything reset.sh deletes belongs here, plus the things it cannot delete
# because they are yours rather than the engine's. If you add a rule here,
# check whether reset.sh should learn about it too; the two lists drifting
# apart is how debris starts getting committed again.

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- Generated by the setup wizard ----------------------------------------
# Anchored to the repo root on purpose. An unanchored `config.json` would also
# match lore/body_config.json and the other four tracked lore files.
/config.json

# --- Engine state (written at runtime, never authored) --------------------
logs/
memories/
saves/
scratch/
output/
tools/cache/
/legacy.json
/fractal_adventure.json

# Words the engine taught itself, and the lenses it derived. Both are
# regenerated on demand and are deliberately kept out of the hand-written
# lexicon; see OVERVIEW.md on saves/cortex_hive.json.
lore/lenses.json
lore/akashic_discovered_words.json

# --- Test debris ----------------------------------------------------------
MagicMock/
test_telemetry_logs/
tests/memories/
tests_isolated_legacy*.json
test_output_full.log
test_memories.log
test_saves.log
test_telemetry.log
test_strata.json
dummy.jsonl

# --- Editors and OS -------------------------------------------------------
# .idea/ is deliberately absent: the PyCharm project files are tracked.
*.swp
.DS_Store
